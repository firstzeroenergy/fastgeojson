## Generated from src/Makevars.win.in by tools/config.R -- DO NOT EDIT.
## Regenerate with: Rscript tools/config.R

TARGET_DIR = rust/target
LIBDIR     = @LIBDIR@
STATLIB    = $(LIBDIR)/libfastgeojson.a

PKG_LIBS = -L$(LIBDIR) -lfastgeojson @EXTRA_LIBS@

CARGO_BUILD_FLAGS = --lib @PROFILE@ @CRAN_FLAGS@ @TARGET_FLAG@

.PHONY: all clean clean_rust

# `all` and `clean_rust` are declared without commands so their prerequisites
# merge with R's own shlib rules; `clean_rust: $(SHLIB)` then guarantees the
# cleanup runs AFTER linking, even under `make -j`.
#
# Deleting rust/target here is what keeps `checking compiled code` clean.
# After `make all`, R CMD INSTALL under --as-cran runs `make symbols.rds`,
# which reads symbols from every `.a` under the package that matches a -l in
# PKG_LIBS; libfastgeojson.a carries Rust's std, whose `abort`/`exit`
# references would then be attributed to it ("Object: rust/target/...") and
# graded a WARNING. Gone before that step, nothing is attributable.
all: $(SHLIB) clean_rust

clean_rust: $(SHLIB)
	rm -rf @CLEAN_TARGET@ rust/.cargo rust/vendor

clean:
	rm -rf $(SHLIB) $(OBJECTS) rust/target rust/.cargo rust/vendor

$(SHLIB): $(STATLIB)

$(STATLIB):
	@echo "== fastgeojson: Rust toolchain =="
	rustc --version
	cargo --version

	# Rust's *-pc-windows-gnu std references libgcc_eh, which Rtools'
	# static-posix toolchain does not ship under that name. An empty stub on
	# LIBRARY_PATH satisfies the reference; the real unwinder comes from
	# -static-libgcc at the final R link step.
	mkdir -p $(TARGET_DIR)/libgcc_mock
	touch $(TARGET_DIR)/libgcc_mock/libgcc_eh.a

	@echo "== fastgeojson: vendored dependencies =="
	mkdir -p rust/.cargo
	if [ -f rust/vendor.tar.xz ]; then \
		tar xf rust/vendor.tar.xz -C rust && \
		echo '[source.crates-io]' > rust/.cargo/config.toml && \
		echo 'replace-with = "vendored-sources"' >> rust/.cargo/config.toml && \
		echo '[source.vendored-sources]' >> rust/.cargo/config.toml && \
		echo 'directory = "vendor"' >> rust/.cargo/config.toml; \
	fi

	@echo "== fastgeojson: cargo build (target: @TARGET@) =="
	export LIBRARY_PATH="$(LIBRARY_PATH);`pwd`/$(TARGET_DIR)/libgcc_mock" && \
	export CARGO_HOME="`pwd`/rust/.cargo" && \
	cargo build $(CARGO_BUILD_FLAGS) \
		--manifest-path=rust/Cargo.toml \
		--target-dir=$(TARGET_DIR)
