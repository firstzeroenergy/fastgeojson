# src/Makevars.in

TARGET_DIR = rust/target
LIBDIR     = $(TARGET_DIR)/release
STATLIB    = $(LIBDIR)/libfastgeojson.a

PKG_LIBS   = -L$(LIBDIR) -lfastgeojson @DARWIN_LDFLAGS@

# CRAN Policy: Use local directory for Cargo
CARGO_HOME = $(CURDIR)/rust/.cargo

.PHONY: all cleanup

all: cleanup

# Cleanup runs ONLY after linking is done (safe under make -j)
cleanup: $(SHLIB)
	rm -rf $(TARGET_DIR) rust/.cargo rust/vendor

# Ensure Rust static library exists before linking
$(SHLIB): $(STATLIB)

$(STATLIB):
	@echo "== fastgeojson: Rust toolchain =="
	rustc --version
	cargo --version

	@echo "== fastgeojson: setup vendored deps =="
	mkdir -p "$(CARGO_HOME)"
	if [ -f rust/vendor.tar.xz ]; then \
		tar xf rust/vendor.tar.xz -C rust && \
		echo '[source.crates-io]' > "$(CARGO_HOME)/config.toml" && \
		echo 'replace-with = "vendored-sources"' >> "$(CARGO_HOME)/config.toml" && \
		echo '[source.vendored-sources]' >> "$(CARGO_HOME)/config.toml" && \
		echo 'directory = "vendor"' >> "$(CARGO_HOME)/config.toml"; \
	fi

	@echo "== fastgeojson: build Rust =="
	export CARGO_HOME="$(CARGO_HOME)"; \
	if [ -f rust/vendor.tar.xz ]; then \
		echo "Building OFFLINE."; \
		cargo build -j 2 --release --lib --offline \
			--manifest-path=rust/Cargo.toml \
			--target-dir $(TARGET_DIR); \
	else \
		echo "Building ONLINE."; \
		cargo build -j 2 --release --lib \
			--manifest-path=rust/Cargo.toml \
			--target-dir $(TARGET_DIR); \
	fi

clean:
	rm -f $(SHLIB) $(OBJECTS)
	rm -rf $(TARGET_DIR) rust/.cargo rust/vendor
