# src/Makevars.win

TARGET = $(subst 64,x86_64,$(subst 32,i686,$(WIN)))-pc-windows-gnu

# IMPORTANT: keep these RELATIVE to avoid spaces/parentheses in -L flags
TARGET_DIR = rust/target
LIBDIR = $(TARGET_DIR)/$(TARGET)/release
STATLIB = $(LIBDIR)/libfastgeojson.a

PKG_LIBS = -L$(LIBDIR) -lfastgeojson \
           -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll

# Local Cargo home (relative)
CARGO_HOME = rust/.cargo

.PHONY: all cleanup

all: cleanup

# Cleanup runs ONLY after linking is done (safe under make -j)
cleanup: $(SHLIB)
	rm -rf "$(TARGET_DIR)" "rust/.cargo" "rust/vendor"

# Ensure Rust static library exists before linking
$(SHLIB): $(STATLIB)

$(STATLIB):
	rustc --version
	cargo --version

	mkdir -p "$(TARGET_DIR)/libgcc_mock"
	touch "$(TARGET_DIR)/libgcc_mock/libgcc_eh.a"

	mkdir -p "$(CARGO_HOME)"
	# FIX: Combined onto one line for safety
	if [ -f "rust/vendor.tar.xz" ]; then \
		tar xf "rust/vendor.tar.xz" -C "rust" && \
		echo '[source.crates-io]' > "$(CARGO_HOME)/config.toml" && \
		echo 'replace-with = "vendored-sources"' >> "$(CARGO_HOME)/config.toml" && \
		echo '[source.vendored-sources]' >> "$(CARGO_HOME)/config.toml" && \
		echo 'directory = "vendor"' >> "$(CARGO_HOME)/config.toml"; \
	fi

	# Use ':' for sh environments; keep everything relative
	export LIBRARY_PATH="$(LIBRARY_PATH):$(TARGET_DIR)/libgcc_mock" && \
	export RUSTFLAGS="$(RUSTFLAGS) --print=native-static-libs" && \
	export CARGO_HOME="$(CARGO_HOME)" && \
	if [ -f "rust/vendor.tar.xz" ]; then \
		echo "Building OFFLINE (Windows)..." && \
		cargo build -j 2 --target=$(TARGET) --lib --release --offline \
		  --manifest-path="rust/Cargo.toml" \
		  --target-dir="$(TARGET_DIR)"; \
	else \
		echo "Building ONLINE (Windows)..." && \
		cargo build -j 2 --target=$(TARGET) --lib --release \
		  --manifest-path="rust/Cargo.toml" \
		  --target-dir="$(TARGET_DIR)"; \
	fi

clean:
	rm -rf "$(SHLIB)" "$(STATLIB)" "$(OBJECTS)" "$(TARGET_DIR)" "rust/.cargo" "rust/vendor"