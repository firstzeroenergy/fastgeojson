#!/bin/sh
# configure: generate src/Makevars from src/Makevars.in

# Make rustup installs discoverable if present
export PATH="$HOME/.cargo/bin:$PATH"

# 1) Check for rustc (compiler)
if ! command -v rustc >/dev/null 2>&1; then
  echo "-------------------------------------------------------------------"
  echo "ERROR: Rust compiler (rustc) not found."
  echo "Please install Rust (rustc + cargo): https://rustup.rs/"
  echo "-------------------------------------------------------------------"
  exit 1
fi

# 2) Check for cargo (package manager)
if ! command -v cargo >/dev/null 2>&1; then
  echo "-------------------------------------------------------------------"
  echo "ERROR: Cargo package manager not found."
  echo "Please install Rust (rustc + cargo): https://rustup.rs/"
  echo "-------------------------------------------------------------------"
  exit 1
fi

# 3) Print versions for the install log (CRAN request)
echo "Using Rust toolchain:"
rustc --version
cargo --version

# 4) Platform checks
UNAME_S=`uname -s`
DARWIN_LDFLAGS=""

if [ "$UNAME_S" = "Darwin" ]; then
  DARWIN_LDFLAGS="-Wl,-dead_strip -Wl,-x"
fi

sed "s|@DARWIN_LDFLAGS@|$DARWIN_LDFLAGS|g" src/Makevars.in > src/Makevars

exit 0
